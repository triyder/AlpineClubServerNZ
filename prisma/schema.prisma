// AlpineClubServerNZ — central hub database schema
// Single source of truth for all database models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  USER
}

enum ClubStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

// ---------------------------------------------------------------------------
// Communication Portal enums.
//
// There is deliberately NO PostScope enum. Club-only posts never leave the
// AlpineClubBookingsNZ install that wrote them, so every post stored here is a
// post a club chose to share with the whole network — there is nothing to
// distinguish. Privacy comes from the data never being transmitted rather than
// from a filter that a bug could invert.
// ---------------------------------------------------------------------------

enum PostHiddenBy {
  SYSTEM // auto-hidden on reaching the report threshold
  ADMIN // hidden by a central admin pending review
}

enum PostRemovedBy {
  CLUB // the authoring club deleted or un-shared it
  ADMIN // a central admin removed it
  RETENTION // aged out of the retention window
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  HARASSMENT
  OTHER
}

// ---------------------------------------------------------------------------
// Users — operators of the central server web UI.
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String    @map("password_hash")
  role              Role      @default(USER)
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Clubs this user has acted on (approvals/rejections). Optional linkage.
  reviewedClubs Club[] @relation("ClubReviewer")

  // Audit entries this user caused. Lets the audit screen name the admin who
  // hid, edited or removed a post rather than only recording that it happened.
  auditLogs AuditLog[]

  // Sync issues this user flagged as cleared.
  clearedSyncIssues SyncIssue[] @relation("SyncIssueClearedBy")

  // Library pictures this user uploaded.
  uploadedImages Image[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Clubs / Lodges — client installations of AlpineClubBookingsNZ that link to
// this central server. Go through a Pending -> Approved/Rejected lifecycle.
// ---------------------------------------------------------------------------

model Club {
  id           String     @id @default(cuid())
  name         String
  code         String     @unique
  location     String?
  contactEmail String     @map("contact_email")
  status       ClubStatus @default(PENDING)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Who approved/rejected this club, and when.
  reviewedById String?   @map("reviewed_by_id")
  reviewedBy   User?     @relation("ClubReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime? @map("reviewed_at")

  apiTokens            ApiToken[]
  auditLogs            AuditLog[]
  // "Other lodges" this club uploaded to the central registry (provenance).
  submittedOtherLodges OtherLodge[] @relation("OtherLodgeSource")
  // "Other lodges" this club most recently pushed an update to.
  updatedOtherLodges   OtherLodge[] @relation("OtherLodgeLastUpdatedBy")

  // Communication Portal: posts this club shared with the network, and reports
  // its members filed against posts from anywhere.
  posts       Post[]
  postReports PostReport[] @relation("PostReportClub")

  // Where this club wants shared posts pushed to, and which generation of its
  // signing secret is current.
  //
  // The SECRET ITSELF IS NOT STORED. It is derived on demand from the server's
  // signing key and this pair — see push-delivery.ts — so a database dump does
  // not hand over the ability to forge pushes to every club on the network.
  // Bumping the version rotates one club's secret without touching any other.
  pushUrl           String? @map("push_url") @db.VarChar(2000)
  pushSecretVersion Int     @default(1) @map("push_secret_version")
  // Set when a club registers a target and cleared when it withdraws one, so
  // "registered but paused" is expressible rather than being conflated with
  // "never registered".
  pushEnabled       Boolean @default(true) @map("push_enabled")

  deliveries PostDelivery[]

  // The API version this club last reported (`major.minor`, see
  // src/lib/api-version.ts) and when it last asked the version endpoint. Null
  // means the club has never reported one — software older than the version
  // check. Stamped by the version check and by any request that carries the
  // version header.
  lastReportedApiVersion String?   @map("last_reported_api_version") @db.VarChar(16)
  lastVersionCheckAt     DateTime? @map("last_version_check_at")

  syncIssues SyncIssue[]

  // When this club last pulled GET /api/v1/feed/sync. Stamped by that endpoint
  // ONLY — deliberately distinct from ApiToken.lastUsedAt, which any
  // authenticated call bumps. This is what answers "has this club actually
  // received the post I removed?", which lastUsedAt would overstate.
  lastCommsSyncAt DateTime? @map("last_comms_sync_at")

  @@index([status])
  @@map("clubs")
}

// ---------------------------------------------------------------------------
// API Tokens / Application Keys — issued to an approved Club so its local
// AlpineClubBookingsNZ install can authenticate to this server. Only the hash
// is stored; the plaintext is shown exactly once at generation time.
// ---------------------------------------------------------------------------

model ApiToken {
  id          String    @id @default(cuid())
  clubId      String    @map("club_id")
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique @map("token_hash")
  // Short non-secret prefix (e.g. "acs_ab12cd34") for display/lookup.
  tokenPrefix String    @map("token_prefix")
  scopes      String[]  @default([])
  revokedAt   DateTime? @map("revoked_at")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  auditLogs AuditLog[]

  @@index([clubId])
  @@index([tokenPrefix])
  @@map("api_tokens")
}

// ---------------------------------------------------------------------------
// Audit Logs — record connections and requests made by client applications
// (and notable admin actions), for oversight and abuse investigation.
// ---------------------------------------------------------------------------

model AuditLog {
  id        String       @id @default(cuid())
  action    String
  outcome   AuditOutcome @default(SUCCESS)
  clubId    String?      @map("club_id")
  club      Club?        @relation(fields: [clubId], references: [id], onDelete: SetNull)
  tokenId   String?      @map("token_id")
  token     ApiToken?    @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  // The console user who performed the action, for admin-initiated entries.
  // Null for client-API activity, which is attributed by club/token instead.
  userId    String?      @map("user_id")
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress String?      @map("ip_address")
  userAgent String?      @map("user_agent")
  // Free-form structured context (request path, sync counts, error, ...).
  metadata  Json?
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([clubId])
  @@index([action])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Other Lodges — the central registry of external / partner lodges. Replicates
// the AlpineClubBookingsNZ "Other lodges" admin panel, but here it is the
// SHARED source of truth: connected clubs upload their entries and every entry
// is handed back out to every connected club via the clubs API key.
//
// `name` is unique so the registry backs a name-first list / drop-down.
// `sourceClub` records which club uploaded it (null = created centrally).
// ---------------------------------------------------------------------------

model OtherLodge {
  id                  String  @id @default(cuid())
  name                String  @unique
  location            String? @db.VarChar(300)
  bookingOfficerName  String? @map("booking_officer_name") @db.VarChar(200)
  bookingOfficerEmail String? @map("booking_officer_email") @db.VarChar(320)
  bookingOfficerPhone String? @map("booking_officer_phone") @db.VarChar(50)
  bedCapacity         Int?    @map("bed_capacity")

  // Lodge details beyond contact and capacity. The yes/no columns are plain
  // booleans defaulting to false, so an existing row reads "no" until someone
  // says otherwise — "not known" and "no" are deliberately not distinguished.
  // The two season dates are calendar dates WITH a year (DATE, no time of day).
  siteUrl              String?   @map("site_url") @db.VarChar(500)
  bookingPath          String?   @map("booking_path") @db.VarChar(300)
  requiresLodgeCustodian Boolean @default(false) @map("requires_lodge_custodian")
  freeWifi             Boolean   @default(false) @map("free_wifi")
  quietRoom            Boolean   @default(false) @map("quiet_room")
  dryingRoom           Boolean   @default(false) @map("drying_room")
  sharedKitchen        Boolean   @default(false) @map("shared_kitchen")
  wheelchairAccessible Boolean   @default(false) @map("wheelchair_accessible")
  breakfastIncluded    Boolean   @default(false) @map("breakfast_included")
  lunchIncluded        Boolean   @default(false) @map("lunch_included")
  dinnerIncluded       Boolean   @default(false) @map("dinner_included")
  cancellationPeriod   String?   @map("cancellation_period") @db.VarChar(200)
  winterSeasonStart    DateTime? @map("winter_season_start") @db.Date
  summerSeasonStart    DateTime? @map("summer_season_start") @db.Date

  amenities Amenity[]

  // Pictures chosen from the image library. SetNull: a lodge outlives its
  // picture, though the image manager refuses to delete one that is in use.
  imageId String? @map("image_id")
  image   Image?  @relation("LodgeImage", fields: [imageId], references: [id], onDelete: SetNull)
  logoId  String? @map("logo_id")
  logo    Image?  @relation("LodgeLogo", fields: [logoId], references: [id], onDelete: SetNull)

  // Provenance: the club that uploaded this entry (null = created centrally by
  // an admin on this server). SetNull so removing a club keeps the lodge.
  sourceClubId String? @map("source_club_id")
  sourceClub   Club?   @relation("OtherLodgeSource", fields: [sourceClubId], references: [id], onDelete: SetNull)

  // Change tracking: the club that most recently uploaded a change to this
  // entry, and when. Stamped on every client upload (create or update).
  lastUpdatedByClubId String?   @map("last_updated_by_club_id")
  lastUpdatedByClub   Club?     @relation("OtherLodgeLastUpdatedBy", fields: [lastUpdatedByClubId], references: [id], onDelete: SetNull)
  lastUploadedAt      DateTime? @map("last_uploaded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sourceClubId])
  @@index([imageId])
  @@index([logoId])
  @@map("other_lodges")
}

// ---------------------------------------------------------------------------
// Communication Portal — the cross-club message board.
//
// A post reaches this server ONLY when a member ticked "share with all clubs"
// in their AlpineClubBookingsNZ install. Club-local posts stay in that install
// and are never uploaded, so everything below concerns network posts only.
//
// The authoring club keeps its own canonical copy; this row is the
// distribution copy that every other club mirrors.
// ---------------------------------------------------------------------------

model Post {
  id     String @id @default(cuid())
  clubId String @map("club_id")
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  // Author identity as asserted by the posting club's install. The server
  // cannot verify it — it trusts the club's API key — so treat these as
  // club-attested, not authenticated. See docs/comms-portal-spec.md.
  //
  // authorUserId and authorEmail are held for moderation only and are NEVER
  // serialized to a client: the authoring club already has them, and no other
  // club needs another club's member identifiers or addresses.
  authorUserId String  @map("author_user_id")
  authorEmail  String? @map("author_email") @db.VarChar(320)
  // The one author field clients do receive — it is what readers see.
  authorName   String  @map("author_name") @db.VarChar(200)

  content String @db.VarChar(4000)

  // The sanitised rich body, when the sending club had one. Null for a plain
  // post and for anything whose HTML sanitised away to nothing — `content` is
  // authoritative in both cases, which is why it is not optional.
  //
  // Sanitised BY THIS SERVER on receipt, never merely accepted: an API key
  // proves which club is calling and nothing about what its members wrote, and
  // this body is handed to every other club's browser.
  bodyHtml String? @map("body_html") @db.VarChar(20000)

  // Cached count of NON-dismissed reports. Recomputed from the report rows on
  // every report and every dismissal, never blind-incremented, so it cannot
  // drift away from the rows it summarises.
  reportCount Int @default(0) @map("report_count")

  // Hidden: reversible, content intact, awaiting a human decision.
  hiddenAt DateTime?     @map("hidden_at")
  hiddenBy PostHiddenBy? @map("hidden_by")

  // Reviewed and cleared by an admin: the report threshold must never
  // auto-hide this post again. Without it, unhiding a post that someone is
  // targeting simply restarts the countdown and it re-hides indefinitely.
  autoHideExempt Boolean @default(false) @map("auto_hide_exempt")

  // Removed: content blanked and every image file unlinked AT ONCE, so the
  // material is gone immediately. What survives is a stub row carrying only
  // ids and timestamps, and that stub IS the tombstone that tells mirroring
  // clubs to drop their copy. The retention job deletes it once
  // posts.tombstone_horizon_days has passed.
  //
  // Delete, un-share and age-out all do exactly this and differ only in who
  // caused it, which is what removedBy records.
  removedAt DateTime?      @map("removed_at")
  removedBy PostRemovedBy? @map("removed_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  images         PostImage[]
  reports        PostReport[]
  postDeliveries PostDelivery[]

  // Browse feed pages backwards on (createdAt, id).
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  // The mirroring cursor pages forwards on (updatedAt, id).
  @@index([updatedAt, id])
  @@index([clubId])
  @@index([reportCount])
  // Drives the console's Hidden tab.
  @@index([hiddenAt])
  // Retention sweeps expired stubs by removedAt.
  @@index([removedAt])
  @@map("posts")
}

// One optimised WebP derivative of an uploaded image. The original upload is
// never persisted: it is decoded, resized, re-encoded and discarded.
model PostImage {
  id     String @id @default(cuid())
  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Unguessable 128-bit capability id used in the public image URL. Random,
  // NOT derived from the row id, so holding one feed page does not let anyone
  // enumerate the images of posts they were never sent.
  publicId String @unique @map("public_id")

  // Path RELATIVE to UPLOADS_DIR, e.g. "posts/2026/08/<cuid>.webp".
  // Server-generated and re-resolved against the root before every read or
  // unlink, so a traversal sequence can never escape the uploads directory.
  storageKey String @map("storage_key")

  width    Int
  height   Int
  bytes    Int
  position Int @default(0) // display order within the post, 0-3

  createdAt DateTime @default(now()) @map("created_at")

  @@index([postId])
  @@map("post_images")
}

// A member's report against a network post. The reporting club comes from the
// API token; the member id within that club is club-asserted.
/**
 * One post's delivery to one club.
 * A row per (post, club) rather than a single "delivered" flag on the post,
 * because the interesting state is per-recipient: one club being unreachable
 * must not hold up the other nine, and "which clubs have this" is a question
 * an admin will ask the moment a post is reported.
 * POLLING REMAINS THE BACKSTOP. Every club also pulls /feed/sync on its own
 * schedule, so a delivery that exhausts its attempts is a delay rather than a
 * loss — which is why this table may give up without anyone losing a post.
 */
model PostDelivery {
  id     String @id @default(cuid())
  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  clubId String @map("club_id")
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  /// "created" or "removed" — a withdrawal has to reach the mirrors too, and it
  /// travels the same queue so ordering between the two is preserved per club.
  kind PostDeliveryKind @default(CREATED)

  status        PostDeliveryStatus @default(PENDING)
  attempts      Int                @default(0)
  /// Next time this row is eligible. Backoff moves it forward; a fresh row is
  /// eligible immediately.
  nextAttemptAt DateTime           @default(now()) @map("next_attempt_at")
  deliveredAt   DateTime?          @map("delivered_at")
  /// The last failure, bounded — it can carry a remote's own error text.
  lastError     String?            @map("last_error") @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One delivery per post per club per kind. This is what makes enqueueing
  /// idempotent: a re-share or a repeated withdrawal cannot queue a second
  /// copy, and the worker cannot double-send.
  @@unique([postId, clubId, kind])
  /// The worker's only query: eligible work, oldest first.
  @@index([status, nextAttemptAt])
  @@map("post_deliveries")
}

enum PostDeliveryKind {
  CREATED
  REMOVED
}

enum PostDeliveryStatus {
  PENDING
  DELIVERED
  /// Attempts exhausted, or refused in a way retrying cannot fix. Polling still
  /// carries the post, so this is "not pushed", never "not delivered".
  ABANDONED
}

model PostReport {
  id     String @id @default(cuid())
  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  reporterClubId String @map("reporter_club_id")
  reporterClub   Club   @relation("PostReportClub", fields: [reporterClubId], references: [id], onDelete: Cascade)
  reporterUserId String @map("reporter_user_id")

  reason  ReportReason
  details String?      @db.VarChar(1000)

  // Set when an admin dismisses the report. Dismissed rows stay for the audit
  // trail but stop counting toward reportCount and the auto-hide threshold,
  // which is what lets a wrongly-hidden post become re-reportable by a fresh
  // set of members instead of being permanently immune.
  dismissedAt DateTime? @map("dismissed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Club-scoped on purpose: member ids are unique within a club but collide
  // across clubs, so keying on (post, member) alone would let one club's
  // member block another's from ever reporting the same post.
  @@unique([postId, reporterClubId, reporterUserId])
  @@index([postId])
  @@index([reporterClubId])
  @@map("post_reports")
}

// ---------------------------------------------------------------------------
// Operator-tunable settings and scheduled-job coordination.
// ---------------------------------------------------------------------------

// Small key/value store. Values are strings; src/lib/settings.ts parses and
// defaults them through zod so a missing or malformed row is never fatal.
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// Single-flight claim for scheduled jobs, so the nightly cron and the admin's
// "Run cleanup now" button cannot run the same pass concurrently.
//
// Deliberately NOT a Postgres advisory lock: a session-scoped lock is taken
// and released through Prisma's connection POOL, so the unlock can execute on
// a different connection than the lock and the job wedges until the pool
// recycles. An xact-scoped lock would mean holding a transaction open across
// filesystem I/O. A status-guarded conditional update has neither problem.
model JobClaim {
  name      String    @id
  startedAt DateTime? @map("started_at")

  @@map("job_claims")
}


// ---------------------------------------------------------------------------
// Sync issues — conditions an administrator must look at and flag as cleared.
// Starts with VERSION_MISMATCH (a club reported an API version other than this
// server's); `kind` is a plain string so later kinds need no migration.
// ---------------------------------------------------------------------------

model SyncIssue {
  id            String          @id @default(cuid())
  kind          String          @db.VarChar(40)
  clubId        String          @map("club_id")
  club          Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  clientVersion String?         @map("client_version") @db.VarChar(16)
  serverVersion String          @map("server_version") @db.VarChar(16)
  firstSeenAt   DateTime        @default(now()) @map("first_seen_at")
  lastSeenAt    DateTime        @default(now()) @map("last_seen_at")
  occurrences   Int             @default(1)
  status        SyncIssueStatus @default(OPEN)
  // `${clubId}:${kind}` while OPEN, null once CLEARED. Unique, so two requests
  // racing cannot open two issues for one club and kind (Postgres treats the
  // nulls of cleared rows as distinct, so any number of cleared rows coexist).
  openKey       String?         @unique @map("open_key") @db.VarChar(80)
  clearedById   String?         @map("cleared_by_id")
  clearedBy     User?           @relation("SyncIssueClearedBy", fields: [clearedById], references: [id], onDelete: SetNull)
  clearedAt     DateTime?       @map("cleared_at")
  note          String?         @db.VarChar(500)

  @@index([status])
  @@index([clubId])
  @@map("sync_issues")
}

enum SyncIssueStatus {
  OPEN
  CLEARED
}

// ---------------------------------------------------------------------------
// Amenities — free-form extras a lodge offers, many to one lodge. Name is unique
// within a lodge. Cascade-deleted with the lodge. A change here counts as a
// change to the lodge (its updatedAt is moved by the writer) so the incremental
// pull sees it.
// ---------------------------------------------------------------------------

model Amenity {
  id          String     @id @default(cuid())
  lodgeId     String     @map("lodge_id")
  lodge       OtherLodge @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  name        String     @db.VarChar(120)
  description String?    @db.VarChar(1000)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@unique([lodgeId, name])
  @@map("amenities")
}

// ---------------------------------------------------------------------------
// Image library — pictures an administrator uploads once and then attaches to a
// lodge (as its picture or its logo). `kind` is fixed at upload so a logo picker
// only ever offers logos. The file lives under UPLOADS_DIR at `storageKey`; the
// 128-bit `publicId` is the capability in its public URL, as for post images.
// ---------------------------------------------------------------------------

enum ImageKind {
  IMAGE
  LOGO
}

model Image {
  id       String    @id @default(cuid())
  kind     ImageKind @default(IMAGE)
  // Display name, taken from the uploaded file name and editable.
  name     String    @db.VarChar(200)
  publicId String    @unique @map("public_id")
  // Path RELATIVE to UPLOADS_DIR, e.g. "library/2026/10/<hex>.webp".
  storageKey String  @map("storage_key")
  width    Int
  height   Int
  bytes    Int

  uploadedById String? @map("uploaded_by_id")
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  lodgesUsingAsImage OtherLodge[] @relation("LodgeImage")
  lodgesUsingAsLogo  OtherLodge[] @relation("LodgeLogo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kind, createdAt])
  @@map("images")
}
