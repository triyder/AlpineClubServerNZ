# ---------------------------------------------------------------------------
# AlpineClubServerNZ — environment configuration
# Copy to `.env` for local development. In Docker these are supplied by
# docker-compose.yml; never commit a real `.env`.
# ---------------------------------------------------------------------------

# Postgres connection. When running the app inside docker-compose the host is
# the service name `db`; for host-based `npm run dev` use localhost.
POSTGRES_USER=alpine
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=alpineserver
DATABASE_URL=postgresql://alpine:change-me-in-production@localhost:5432/alpineserver?schema=public

# Loopback host port the Postgres container is published on (psql / Prisma
# Studio / GUIs). Defaults to 5433 to avoid AlpineClubBookingsNZ's 5432. This
# is the HOST-side port only; inside the compose network the app still reaches
# the DB as `db:5432`. To connect from the host, use:
#   postgresql://alpine:...@localhost:5433/alpineserver
DB_HOST_PORT=5433

# Secret used to sign JWT session cookies (HS256). Must be >= 32 chars.
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Public domain Caddy serves. Use `localhost` for local TLS-less testing.
DOMAIN=localhost

# Host ports Caddy publishes. Defaults are 80/443 for a dedicated-host
# deployment. When running side-by-side with AlpineClubBookingsNZ (which also
# fronts with Caddy on 80/443) on the same machine, override these — e.g.
# WEB_HTTP_PORT=8080 and WEB_HTTPS_PORT=8443 — and reach the console at
# https://localhost:8443.
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# The reverse proxy in front of Caddy (space-separated IPs or CIDRs), whose
# X-Forwarded-For Caddy believes. Set it to Nginx Proxy Manager's address when
# NPM fronts this stack, otherwise every visitor arrives as NPM's address and
# shares one rate limit (and the audit log records only NPM). Default: loopback.
# TRUSTED_PROXIES=192.168.1.101

# Default admin seeded by `npm run seed` when no admin exists. In production
# the seed refuses the example password below (or anything under 12 chars).
SEED_ADMIN_EMAIL=admin@alpineclub.nz
SEED_ADMIN_PASSWORD=ChangeMe123!

# Session idle timeout in seconds (default 12 hours): the console re-issues
# the session while it is in use. SESSION_ABSOLUTE_MAX_AGE is the longest a
# sign-in lasts however active (default 7 days).
SESSION_MAX_AGE=43200
SESSION_ABSOLUTE_MAX_AGE=604800

# Whether the session cookie is marked `Secure` (HTTPS-only). Leave unset in
# production (defaults on). Set to `false` ONLY for plain-HTTP local dev
# browsing — the docker-compose.dev.yml overlay sets this for you. A `Secure`
# cookie is dropped by the browser over HTTP, so login would fail without this.
# SESSION_COOKIE_SECURE=false

# API rate limit: max requests per window per client token/IP.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Where Communication Portal images are stored. In Docker this is a named
# volume (see docker-compose.yml) and must stay OUTSIDE `public/`, because the
# Dockerfile copies `public/` from the build stage and Next only serves assets
# that existed at build time. Defaults to ./data/uploads outside production;
# required in production, so a misconfigured deploy fails loudly rather than
# writing images into a container layer that the next rebuild discards.
UPLOADS_DIR=./data/uploads

# Absolute origin clients should use for image URLs, and the only origin the
# console's admin write requests are accepted from (#13). Normally unset: the
# app derives it from the X-Forwarded-* headers Caddy sets. Set it only when
# the public origin differs from what reaches the app, e.g. an extra proxy hop
# (such as Nginx Proxy Manager / openresty in front of Caddy, talking plain
# http to it), and then to exactly the address the console is opened at.
# Also the address the new-club email's review link points at; without it that
# mail carries no link (the request's own Host header is never trusted for it).
# PUBLIC_BASE_URL=https://alpine.example.nz

# Run the nightly post-retention job outside production (it is always on in
# production). Off by default so `next dev` does not schedule it on reload.
# POSTS_CLEANUP_ENABLED=true

# Push delivery of shared posts to club installs (Communication Portal)
#
# Every club's signing secret is DERIVED from this key plus its club id and
# secret version, so no per-club secret is stored: a database dump does not
# hand over the ability to forge pushes to the whole network. The cost of that
# is that CHANGING THIS KEY INVALIDATES EVERY CLUB'S SECRET AT ONCE and each
# club must re-register its push target. To rotate one club instead, bump that
# club's push_secret_version.
#
# At least 32 characters. Generate with:  openssl rand -hex 32
# Unset, sharing still works: clubs receive posts by polling /api/v1/feed/sync,
# which is the guarantee. Only the fast path stops.
PUSH_SIGNING_KEY=

# Encrypts the secrets an administrator types into Settings (the SMTP
# password, #33) before they reach the database. At least 32 characters;
# generate with:  openssl rand -hex 32
# Unset, Settings → Email refuses to store a password; changing it after a
# password was saved means entering the password again.
SETTINGS_ENCRYPTION_KEY=

# The secret the host's cron presents when it asks the server to send the
# administrator digest (POST /api/jobs/digest, header x-job-secret, #34).
# At least 32 characters; generate with:  openssl rand -hex 32
# Unset, the endpoint answers 401 to everyone and no digest is ever sent.
# Crontab line (daily at 07:15):
#   15 7 * * * curl -fsS -X POST -H "x-job-secret: $JOB_SECRET" https://alpine-server.example.nz/api/jobs/digest
JOB_SECRET=

# Private-network addresses this server may call a club at, comma-separated IP
# literals (no ranges, no names). Every call to a club — push registration,
# push delivery and the public lodge search's free-beds question — refuses a
# hostname that resolves inside a private network, because a club chooses the
# URL. When club sites are reached through a reverse proxy on THIS server's own
# network (their hostnames resolve to that proxy, e.g. 192.168.0.10), name the
# proxy's address here; every other private address stays refused.
ALLOWED_PRIVATE_CLUB_ADDRESSES=

# The club hostnames that may use those addresses, comma-separated exact names
# (e.g. bookings.club-a.nz,bookings.club-b.nz). The proxy at that address also
# serves sites that are not clubs, so without this list a club could point its
# push URL at one of them. Empty = any hostname (a warning is logged).
ALLOWED_PRIVATE_CLUB_HOSTNAMES=
