# ---------------------------------------------------------------------------
# AlpineClubServerNZ — environment configuration
# Copy to `.env` for local development. In Docker these are supplied by
# docker-compose.yml; never commit a real `.env`.
# ---------------------------------------------------------------------------

# Postgres connection. When running the app inside docker-compose the host is
# the service name `db`; for host-based `npm run dev` use localhost.
POSTGRES_USER=alpine
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=alpineserver
DATABASE_URL=postgresql://alpine:change-me-in-production@localhost:5432/alpineserver?schema=public

# Loopback host port the Postgres container is published on (psql / Prisma
# Studio / GUIs). Defaults to 5433 to avoid AlpineClubBookingsNZ's 5432. This
# is the HOST-side port only; inside the compose network the app still reaches
# the DB as `db:5432`. To connect from the host, use:
#   postgresql://alpine:...@localhost:5433/alpineserver
DB_HOST_PORT=5433

# Secret used to sign JWT session cookies (HS256). Must be >= 32 chars.
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Public domain Caddy serves. Use `localhost` for local TLS-less testing.
DOMAIN=localhost

# Host ports Caddy publishes. Defaults are 80/443 for a dedicated-host
# deployment. When running side-by-side with AlpineClubBookingsNZ (which also
# fronts with Caddy on 80/443) on the same machine, override these — e.g.
# WEB_HTTP_PORT=8080 and WEB_HTTPS_PORT=8443 — and reach the console at
# https://localhost:8443.
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# Default admin seeded by `npm run seed` when no admin exists.
SEED_ADMIN_EMAIL=admin@alpineclub.nz
SEED_ADMIN_PASSWORD=ChangeMe123!

# Session lifetime in seconds (default 7 days).
SESSION_MAX_AGE=604800

# Whether the session cookie is marked `Secure` (HTTPS-only). Leave unset in
# production (defaults on). Set to `false` ONLY for plain-HTTP local dev
# browsing — the docker-compose.dev.yml overlay sets this for you. A `Secure`
# cookie is dropped by the browser over HTTP, so login would fail without this.
# SESSION_COOKIE_SECURE=false

# API rate limit: max requests per window per client token/IP.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
